# 复制为 .env 后按需填写。不填也能以本地降级模式运行（规则模型 + 哈希向量）。

# 模型：留空则使用内置规则模型（无需网络）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# 显式指定向量维度可覆盖自动推断（OpenAI=1536，本地=256）
EMBEDDING_DIM=

# 持久化：留空则使用内存 checkpoint 与本地文件索引
DATABASE_URL=

# 路径（相对于项目根目录，或绝对路径）
DOCS_DIR=docs
DATA_DIR=data

# 业务参数
APPROVAL_THRESHOLD=2000
TOKEN_BUDGET=8000
MAX_TURNS=6
RETRIEVAL_TOP_K=4
PROMPT_TOP_K=2

# 观测（可选，留空则不上传）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# 服务
API_HOST=0.0.0.0
API_PORT=8000
